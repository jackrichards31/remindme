# Supabase project settings — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses Row Level Security. Never expose
# this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Until you verify a domain in Resend, leave unset — it falls back to
# onboarding@resend.dev, which only delivers to your own Resend account email.
REMINDER_FROM_ADDRESS=

# Used to build the magic-link redirect URL. Set to your deployed URL in
# production (e.g. https://remindme.vercel.app); safe to leave unset locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret Vercel Cron uses to authenticate calls to /api/cron/daily —
# generate any random string (e.g. `openssl rand -hex 32`) and set the same
# value in your Vercel project's environment variables.
CRON_SECRET=
